{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomada",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  // Conserva las variables definidas en el panel de Cloudflare (p. ej. GOOGLE_MAPS_API_KEY) en cada despliegue.
  "keep_vars": true,
  "routes": [
    {
      "pattern": "nomada.innovasoftgt.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  }
}
